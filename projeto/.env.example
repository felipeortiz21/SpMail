# SpMail - configuração de ambiente
# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados reais.
# O instalador (instalador/index.php) gera este arquivo automaticamente - você
# só precisa mexer aqui manualmente se for configurar sem usar o instalador.

# Conexão com o banco de dados
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=spmail

# Chave usada para criptografar a senha de envio de email (SMTP) salva no
# banco. Gerada automaticamente pelo instalador. Se for definir na mão, use
# uma string aleatória de pelo menos 32 caracteres e NUNCA reaproveite entre
# instalações diferentes (trocar a chave invalida senhas já criptografadas).
APP_KEY=
